# PostgreSQL connection used by the application.
# For Neon, use the pooled connection URL.
DATABASE_URL="postgresql://USER:PASSWORD@POOLED_HOST/DATABASE?sslmode=verify-full"

# Direct PostgreSQL connection used by Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=verify-full"

# Generate your own value with: openssl rand -hex 32
BETTER_AUTH_SECRET=""

# Local application URL. Change this for deployment.
BETTER_AUTH_URL="http://localhost:3000"
